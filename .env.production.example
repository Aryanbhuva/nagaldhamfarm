# ==============================================================================
# Nagaldham Farm — Production Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="Nagaldham Farm"
APP_ENV=production
APP_DEBUG=false

# Generate APP_KEY using: php artisan key:generate --show or `make key`
APP_KEY=

APP_URL=https://nagaldhamfarm.shop


# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Drivers
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Server HTTP Port Mapping
HTTP_PORT=8080

# Image tag deployed by CI/CD
IMAGE_TAG=latest

